# Tech Lead reviewer runtime identity. The only place the model and effort are set;
# dispatchers never choose them, and no generated adapter may pin them.

# --- Primary path (required) ---------------------------------------------------
# Dispatched by bin/review-gate.sh at every gate. Only "codex" is driven by that
# script today; another provider needs its own dispatcher supplying the same prompt.
TECH_LEAD_PROVIDER=codex
TECH_LEAD_MODEL=gpt-5.6-sol
TECH_LEAD_EFFORT=max

# --- Second path (optional) ----------------------------------------------------
# A second, independent review at gates 3 and 4 on the same artifact, so two
# providers can be compared. Off by default: it costs a second review and needs a
# model your plan includes.
#
# When false, no subagent adapter is generated and the dispatch instructions say
# nothing about a second reviewer -- a project that cannot run one is never told to.
TECH_LEAD_SECOND_ENABLED=false
TECH_LEAD_SECOND_MODEL=fable
TECH_LEAD_SECOND_EFFORT=max
